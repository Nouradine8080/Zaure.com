  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only private user accounts containing PII (email, phone)."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII public member profiles readable by authenticated users."
    },
    "/user_settings/{userId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Owner-only private user settings and blocked users list."
    },
    "/circles/{circleId}": {
      "schema": { "$ref": "#/entities/Circle" },
      "description": "Publicly readable catalog of thematic learning circles."
    },
    "/circle_members/{memberId}": {
      "schema": { "$ref": "#/entities/CircleMember" },
      "description": "Owner-scoped circle membership links."
    },
    "/capsules/{capsuleId}": {
      "schema": { "$ref": "#/entities/Capsule" },
      "description": "Educational capsules authored by authenticated users."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments attached to existing capsules."
    },
    "/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/Reaction" },
      "description": "User reactions attached to existing capsules."
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private 1-on-1 and group conversations restricted to participant_ids."
    },
    "/conversations/{convId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a conversation, gated by parent conversation participation."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "Moderation reports readable only by reporter or verified admin/moderator."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/CommunityGroup" },
      "description": "Community circles directory with privacy, rules, and governance settings."
    },
    "/group_members/{memberDocId}": {
      "schema": { "$ref": "#/entities/CommunityMember" },
      "description": "Community circle memberships with roles (administrateur, moderateur, membre) and statuses."
    },
    "/group_posts/{postId}": {
      "schema": { "$ref": "#/entities/GroupPost" },
      "description": "Posts inside community circles supporting multi-media, links, documents, polls, pinning, and scheduling."
    },
    "/post_comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Threaded comments and mentions inside community posts."
    },
    "/post_reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/PostReaction" },
      "description": "Typed user reactions on community posts."
    },
    "/group_events/{eventId}": {
      "schema": { "$ref": "#/entities/GroupEvent" },
      "description": "Community circle events and RSVPs."
    },
    "/group_announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/GroupAnnouncement" },
      "description": "Official community circle announcements."
    },
    "/group_invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/GroupInvitation" },
      "description": "Member invitations and invite codes for community circles."
    },
    "/group_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/GroupNotification" },
      "description": "Owner-scoped real-time notifications for community activities."
    },
    "/group_reports/{reportId}": {
      "schema": { "$ref": "#/entities/GroupReport" },
      "description": "Moderation reports scoped to a community circle."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Protected administrative staff RBAC registry (SUPER_ADMIN, ADMIN, MODERATOR)."
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/platform_notifications/{notifId}": {
      "schema": { "$ref": "#/entities/PlatformNotification" },
      "description": "Global platform announcements and administrative notifications."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration settings."
    },
    "/user_moderation/{userId}": {
      "schema": { "$ref": "#/entities/UserModeration" },
      "description": "Administrative moderation statuses (active, warned, suspended) per user."
    },
    "/user_follows/{followId}": {
      "schema": { "$ref": "#/entities/UserFollow" },
      "description": "Directed user follow records (${followerId}_${followingId})."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Owner-scoped real-time user notifications across social interactions, follows, messaging, communities, and security alerts."
    },
    "/user_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/UserSessionRecord" },
      "description": "Owner-scoped tracked login sessions and devices."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "User-submitted support requests and bug reports readable by owner or staff."
    }
  }
}
